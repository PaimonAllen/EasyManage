# Copy outside the repository; chmod 600. Configure the actual platform and CA.
EASYMANAGE_SERVER_URL=https://platform.example.internal:8443
EASYMANAGE_CA_CERTIFICATE=/etc/easymanage/tls/ca.crt
EASYMANAGE_ENROLLMENT_TOKEN=REPLACE_WITH_THE_PLATFORMS_RANDOM_ENROLLMENT_TOKEN
EASYMANAGE_AGENT_STATE_DB=/var/lib/easymanage-agent/state.db
EASYMANAGE_REPORT_INTERVAL_SECONDS=10
EASYMANAGE_REQUEST_TIMEOUT_SECONDS=15
# New nodes generate and persist an ID automatically. Keep existing state.db when updating.
# EASYMANAGE_NODE_ID=EXISTING_NODE_UUID
