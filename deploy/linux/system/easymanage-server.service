[Unit]
Description=EasyManage control plane
Documentation=https://github.com/PaimonAllen/EasyManage
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/easymanage-server
EnvironmentFile=/etc/easymanage/server.env
Environment=EASYMANAGE_ADMIN_POLICY=require
ExecStart=/usr/local/sbin/easymanage-server
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
