[Unit]
Description=EasyManage monitoring agent
Documentation=https://github.com/PaimonAllen/EasyManage
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/easymanage-agent
EnvironmentFile=/etc/easymanage/agent.env
Environment=EASYMANAGE_ADMIN_POLICY=require
ExecStart=/usr/local/sbin/easymanage-agent
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/easymanage-agent
LockPersonality=true

[Install]
WantedBy=multi-user.target
