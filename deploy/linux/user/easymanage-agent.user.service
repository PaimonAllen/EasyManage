[Unit]
Description=EasyManage ordinary-user basic monitoring agent
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/easymanage
Environment=EASYMANAGE_ENV_FILE=%h/.local/share/easymanage/config/agent.env
Environment=EASYMANAGE_ADMIN_POLICY=warn
ExecStart=%h/.local/share/easymanage/bin/easymanage-agent
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
Nice=10
TasksMax=64
MemoryMax=256M

[Install]
WantedBy=default.target
