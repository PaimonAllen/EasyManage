# Full Windows service. Replace placeholders; keep this file outside Git with a private NTFS ACL.
EASYMANAGE_SERVER_URL=https://controller.example:8443
# Optional hint; automatic discovery also works when omitted or stale.
# EASYMANAGE_PWSH_PATH='C:/Program Files/PowerShell/7/pwsh.exe'
EASYMANAGE_CA_CERTIFICATE=C:/ProgramData/EasyManage/config/ca.crt
EASYMANAGE_AGENT_STATE_DB=C:/ProgramData/EasyManage/state/state.db
EASYMANAGE_ENROLLMENT_TOKEN=REPLACE_WITH_SCOPED_TOKEN_AT_LEAST_32_CHARACTERS
EASYMANAGE_NODE_ID=REPLACE_WITH_ORIGINAL_OR_ASSIGNED_UUID
EASYMANAGE_REPORT_INTERVAL_SECONDS=10
