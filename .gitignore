# EasyManage tracks source, migrations, deployment templates and lockfiles.
# Keep real configuration and runtime data outside the repository when possible.

# OS / local editor files
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vs/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
*.swp
*.swo
*~
*.code-workspace

# Environment files; placeholder-only examples remain versioned
*.env
*.env.*
!*.env.example
!*.env.*.example

# Certificates, private SSH keys and host inventories
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519
ssh_host_*_key
known_hosts
*.known_hosts

# Private operator files / optional upstream checkouts
AGENTS.md
CLAUDE.md
.claude/settings.local.json
服务器连接方式.md
Notes
Password
/deploy/local/
/third_party/
/vendor_projects/

# Platform / Agent runtime configuration and state (not public *.example.json)
targets.json
staging.json
managed-targets.json
.managed-targets-*.next
platform-update-result.json
platform-update.lock
/state/
/agent/state/
/server/state/
/releases/
platform-releases/
easymanage-controller-backup.*/
platform-update-backup.*/
platform-backup-*/
web-backup.*/

# SQLite databases, sidecars and PostgreSQL backup archives; SQL migrations stay tracked
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.dump
*.dump.sql
*.sql.gz
/backups/

# Logs / temporary files
*.log
*.pid
*.seed
*.tmp
logs/
tmp/
temp/

# Rust / optional native build artifacts (Linux, Windows, macOS)
target/
/bin/
/build/
/dist/
/out/
/artifacts/
CMakeFiles/
CMakeCache.txt
cmake-build-*/
compile_commands.json
*.o
*.obj
*.so
*.so.*
*.dylib
*.dll
*.a
*.lib
*.exe
a.out
*.pdb
*.ilk
*.exp
*.dSYM/

# Frontend / VitePress dependencies, bundles and caches
node_modules/
/web/dist/
/docs/.vitepress/dist/
/docs/.vitepress/.temp/
/docs/.vitepress/cache/
.vite/
*.tsbuildinfo
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python deployment / integration-test environments and caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
*.egg-info/

# Optional local data / test output (not nested source fixtures)
/data/
/outputs/
/runs/
/checkpoints/

# Reserved container support: ignore local overrides, keep deploy/docker/.gitkeep
.docker/
docker-compose.override.yml
*.local.yml
*.local.yaml
