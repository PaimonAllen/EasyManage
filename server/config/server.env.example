# Copy outside the repository; chmod 600. Never use these placeholders in production.
# Either set DATABASE_URL (takes priority) OR the PG* variables below.
# DATABASE_URL=postgresql://easymanage:URL_ENCODED_PASSWORD@127.0.0.1:5432/easymanage?sslmode=prefer
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=easymanage
PGUSER=easymanage
PGPASSWORD=CHANGE_ME
PGSSLMODE=prefer
# Remote database: prefer verify-full with the database server's trusted CA.
# PGSSLROOTCERT=/etc/easymanage/database-ca.crt
EASYMANAGE_DATABASE_MAX_CONNECTIONS=10
EASYMANAGE_ENROLLMENT_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
EASYMANAGE_BIND=0.0.0.0:8443
EASYMANAGE_TLS_CERTIFICATE=/etc/easymanage/tls/server.crt
EASYMANAGE_TLS_PRIVATE_KEY=/etc/easymanage/tls/server.key
EASYMANAGE_WEB_ROOT=/opt/easymanage/web
EASYMANAGE_REPORT_INTERVAL_SECONDS=10
EASYMANAGE_ONLINE_WINDOW_SECONDS=45
EASYMANAGE_METRICS_RETENTION_DAYS=30
# Optional browser-based onboarding; actual registry directory must be writable
# only by the platform service user. Do not copy this example onto existing config.
# EASYMANAGE_OPERATIONS_TARGETS=/path/owned/by/platform/config/targets.json
# EASYMANAGE_AGENT_CA_CERTIFICATE=/etc/easymanage/tls/ca.crt
# System-mode platforms may explicitly choose their approved published release root.
# EASYMANAGE_AGENT_RELEASE_ROOT=/path/to/approved/releases/current
